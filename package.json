{
  "name": "gen-art-zero",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline generator of zero-runtime generative art snippets (mount(el)->destroy)",
  "scripts": {
    "generate": "node generator/gen.mjs --type all --seed 7 --palette 0",
    "check": "node generator/check.mjs",
    "smoke": "node generator/smoke.mjs",
    "pack": "node generator/make-selected.mjs --from-decisions",
    "pack:manifest": "node generator/make-selected.mjs",
    "preview": "node preview/server.mjs",
    "deploy": "node generator/deploy-pages.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
